<!DOCTYPE html>
<html lang="ja">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no" />
  <title>農家のかんたんインボイス - 適格請求書作成アプリ</title>
  
  <!-- Tailwind CSS CDN -->
  <script src="https://cdn.tailwindcss.com"></script>
  <script>
    tailwind.config = {
      theme: {
        extend: {
          colors: {
            farm: {
              50: '#F4F7F2',
              100: '#E6EFE2',
              200: '#CEDBCA',
              500: '#52834A',
              600: '#3D6B36',
              700: '#2F542A',
              800: '#233F20',
              900: '#192C17',
            },
            amber: {
              500: '#D97706',
              600: '#B45309',
            }
          }
        }
      }
    };
  </script>

  <!-- React 18 & ReactDOM 18 -->
  <script src="https://unpkg.com/react@18/umd/react.production.min.js" crossorigin></script>
  <script src="https://unpkg.com/react-dom@18/umd/react-dom.production.min.js" crossorigin></script>
  <!-- Babel Standalone for in-browser JSX parsing -->
  <script src="https://unpkg.com/@babel/standalone/babel.min.js"></script>

  <style>
    @import url('https://fonts.googleapis.com/css2?family=Noto+Sans+JP:wght@400;500;700;900&family=Zen+Old+Mincho:wght@700&display=swap');

    body {
      font-family: 'Noto Sans JP', sans-serif;
      background-color: #F8FAF7;
      color: #2D3748;
      -webkit-tap-highlight-color: transparent;
    }

    .font-serif-mincho {
      font-family: 'Zen Old Mincho', serif;
    }

    /* 印刷時の専用レイアウト (A4縦・余白設定・不要パーツ非表示) */
    @media print {
      body {
        background-color: #ffffff !important;
        color: #000000 !important;
        margin: 0 !important;
        padding: 0 !important;
      }
      .no-print {
        display: none !important;
      }
      .print-sheet {
        box-shadow: none !important;
        border: none !important;
        border-radius: 0 !important;
        padding: 0 !important;
        margin: 0 !important;
        width: 100% !important;
        max-width: 100% !important;
      }
      @page {
        size: A4 portrait;
        margin: 12mm 15mm;
      }
      .page-break {
        page-break-inside: avoid;
      }
    }
  </style>
</head>
<body>
  <div id="root"></div>

  <script type="text/babel">
    const { useState, useEffect, useMemo } = React;

    // CDN等の依存切れを防ぐため、アプリで利用するアイコンを安全なインラインSVGで定義
    const IconWheat = ({ className = "w-5 h-5" }) => (
      <svg className={className} viewBox="0 0 24 24" fill="none" stroke="currentColor" strokeWidth="2" strokeLinecap="round" strokeLinejoin="round">
        <path d="M2 22 16 8"/><path d="M3.47 12.53 5 11l1.53 1.53a3.5 3.5 0 0 1 0 4.94L5 19l-1.53-1.53a3.5 3.5 0 0 1 0-4.94Z"/><path d="M7.47 8.53 9 7l1.53 1.53a3.5 3.5 0 0 1 0 4.94L9 15l-1.53-1.53a3.5 3.5 0 0 1 0-4.94Z"/><path d="M11.47 4.53 13 3l1.53 1.53a3.5 3.5 0 0 1 0 4.94L13 11l-1.53-1.53a3.5 3.5 0 0 1 0-4.94Z"/><path d="M20 2h2v2a4 4 0 0 1-4 4h-2V6a4 4 0 0 1 4-4Z"/><path d="M11.47 17.47 13 19l-1.53 1.53a3.5 3.5 0 0 1-4.94 0L5 19l1.53-1.53a3.5 3.5 0 0 1 4.94 0Z"/><path d="M15.47 13.47 17 15l-1.53 1.53a3.5 3.5 0 0 1-4.94 0L9 15l1.53-1.53a3.5 3.5 0 0 1 4.94 0Z"/><path d="M19.47 9.47 21 11l-1.53 1.53a3.5 3.5 0 0 1-4.94 0L13 11l1.53-1.53a3.5 3.5 0 0 1 4.94 0Z"/>
      </svg>
    );

    const IconPlus = ({ className = "w-5 h-5" }) => (
      <svg className={className} viewBox="0 0 24 24" fill="none" stroke="currentColor" strokeWidth="2.5" strokeLinecap="round" strokeLinejoin="round"><line x1="12" y1="5" x2="12" y2="19"></line><line x1="5" y1="12" x2="19" y2="12"></line></svg>
    );

    const IconTrash = ({ className = "w-5 h-5" }) => (
      <svg className={className} viewBox="0 0 24 24" fill="none" stroke="currentColor" strokeWidth="2" strokeLinecap="round" strokeLinejoin="round"><polyline points="3 6 5 6 21 6"></polyline><path d="M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6m3 0V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2"></path><line x1="10" y1="11" x2="10" y2="17"></line><line x1="14" y1="11" x2="14" y2="17"></line></svg>
    );

    const IconPrinter = ({ className = "w-5 h-5" }) => (
      <svg className={className} viewBox="0 0 24 24" fill="none" stroke="currentColor" strokeWidth="2" strokeLinecap="round" strokeLinejoin="round"><polyline points="6 9 6 2 18 2 18 9"></polyline><path d="M6 18H4a2 2 0 0 1-2-2v-5a2 2 0 0 1 2-2h16a2 2 0 0 1 2 2v5a2 2 0 0 1-2 2h-2"></path><rect x="6" y="14" width="12" height="8"></rect></svg>
    );

    const IconSave = ({ className = "w-5 h-5" }) => (
      <svg className={className} viewBox="0 0 24 24" fill="none" stroke="currentColor" strokeWidth="2" strokeLinecap="round" strokeLinejoin="round"><path d="M19 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h11l5 5v11a2 2 0 0 1-2 2z"></path><polyline points="17 21 17 13 7 13 7 21"></polyline><polyline points="7 3 7 8 15 8"></polyline></svg>
    );

    const IconHistory = ({ className = "w-5 h-5" }) => (
      <svg className={className} viewBox="0 0 24 24" fill="none" stroke="currentColor" strokeWidth="2" strokeLinecap="round" strokeLinejoin="round"><path d="M3 12a9 9 0 1 0 9-9 9.75 9.75 0 0 0-6.74 2.74L3 8"></path><path d="M3 3v5h5"></path><path d="M12 7v5l4 2"></path></svg>
    );

    const IconSettings = ({ className = "w-5 h-5" }) => (
      <svg className={className} viewBox="0 0 24 24" fill="none" stroke="currentColor" strokeWidth="2" strokeLinecap="round" strokeLinejoin="round"><circle cx="12" cy="12" r="3"></circle><path d="M19.4 15a1.65 1.65 0 0 0 .33 1.82l.06.06a2 2 0 0 1 0 2.83 2 2 0 0 1-2.83 0l-.06-.06a1.65 1.65 0 0 0-1.82-.33 1.65 1.65 0 0 0-1 1.51V21a2 2 0 0 1-2 2 2 2 0 0 1-2-2v-.09A1.65 1.65 0 0 0 9 19.4a1.65 1.65 0 0 0-1.82.33l-.06.06a2 2 0 0 1-2.83 0 2 2 0 0 1 0-2.83l.06-.06a1.65 1.65 0 0 0 .33-1.82 1.65 1.65 0 0 0-1.51-1H3a2 2 0 0 1-2-2 2 2 0 0 1 2-2h.09A1.65 1.65 0 0 0 4.6 9a1.65 1.65 0 0 0-.33-1.82l-.06-.06a2 2 0 0 1 0-2.83 2 2 0 0 1 2.83 0l.06.06a1.65 1.65 0 0 0 1.82.33H9a1.65 1.65 0 0 0 1-1.51V3a2 2 0 0 1 2-2 2 2 0 0 1 2 2v.09a1.65 1.65 0 0 0 1 1.51 1.65 1.65 0 0 0 1.82-.33l.06-.06a2 2 0 0 1 2.83 0 2 2 0 0 1 0 2.83l-.06.06a1.65 1.65 0 0 0-.33 1.82V9a1.65 1.65 0 0 0 1.51 1H21a2 2 0 0 1 2 2 2 2 0 0 1-2 2h-.09a1.65 1.65 0 0 0-1.51 1z"></path></svg>
    );

    const IconFileText = ({ className = "w-5 h-5" }) => (
      <svg className={className} viewBox="0 0 24 24" fill="none" stroke="currentColor" strokeWidth="2" strokeLinecap="round" strokeLinejoin="round"><path d="M14.5 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V7.5L14.5 2z"></path><polyline points="14 2 14 8 20 8"></polyline><line x1="16" y1="13" x2="8" y2="13"></line><line x1="16" y1="17" x2="8" y2="17"></line><line x1="10" y1="9" x2="8" y2="9"></line></svg>
    );

    const IconCheck = ({ className = "w-5 h-5" }) => (
      <svg className={className} viewBox="0 0 24 24" fill="none" stroke="currentColor" strokeWidth="2.5" strokeLinecap="round" strokeLinejoin="round"><polyline points="20 6 9 17 4 12"></polyline></svg>
    );

    const IconChevronLeft = ({ className = "w-5 h-5" }) => (
      <svg className={className} viewBox="0 0 24 24" fill="none" stroke="currentColor" strokeWidth="2.5" strokeLinecap="round" strokeLinejoin="round"><polyline points="15 18 9 12 15 6"></polyline></svg>
    );

    const IconArrowRight = ({ className = "w-5 h-5" }) => (
      <svg className={className} viewBox="0 0 24 24" fill="none" stroke="currentColor" strokeWidth="2.5" strokeLinecap="round" strokeLinejoin="round"><line x1="5" y1="12" x2="19" y2="12"></line><polyline points="12 5 19 12 12 19"></polyline></svg>
    );

    const IconSparkles = ({ className = "w-5 h-5" }) => (
      <svg className={className} viewBox="0 0 24 24" fill="none" stroke="currentColor" strokeWidth="2" strokeLinecap="round" strokeLinejoin="round"><path d="m12 3-1.912 5.813a2 2 0 0 1-1.275 1.275L3 12l5.813 1.912a2 2 0 0 1 1.275 1.275L12 21l1.912-5.813a2 2 0 0 1 1.275-1.275L21 12l-5.813-1.912a2 2 0 0 1-1.275-1.275L12 3Z"></path></svg>
    );

    // 農家さんによくある出荷品目マスタ（8%と10%を適切に事前振り分け）
    const PRODUCE_PRESETS = [
      { name: '完熟トマト', unit: '袋', taxRate: 8, defaultPrice: 200, category: '野菜' },
      { name: 'ミニトマト', unit: 'パック', taxRate: 8, defaultPrice: 180, category: '野菜' },
      { name: 'きゅうり', unit: '袋', taxRate: 8, defaultPrice: 150, category: '野菜' },
      { name: '朝採れナス', unit: '袋', taxRate: 8, defaultPrice: 180, category: '野菜' },
      { name: '春キャベツ', unit: '玉', taxRate: 8, defaultPrice: 200, category: '野菜' },
      { name: '白菜', unit: '玉', taxRate: 8, defaultPrice: 280, category: '野菜' },
      { name: 'ほうれん草', unit: '束', taxRate: 8, defaultPrice: 140, category: '野菜' },
      { name: '泥つき長ネギ', unit: '束', taxRate: 8, defaultPrice: 180, category: '野菜' },
      { name: 'コシヒカリ（精米）', unit: '5kg袋', taxRate: 8, defaultPrice: 2400, category: 'お米' },
      { name: 'コシヒカリ（玄米）', unit: '30kg袋', taxRate: 8, defaultPrice: 9800, category: 'お米' },
      { name: '旬の新鮮野菜詰め合わせセット', unit: '箱', taxRate: 8, defaultPrice: 2800, category: 'セット' },
      { name: 'いちご', unit: 'パック', taxRate: 8, defaultPrice: 500, category: '果物' },
      { name: 'りんご（特選）', unit: '箱', taxRate: 8, defaultPrice: 3500, category: '果物' },
      { name: 'クール便送料・運賃', unit: '式', taxRate: 10, defaultPrice: 1100, category: '資材・経費' },
      { name: '出荷用段ボール・資材代', unit: '枚', taxRate: 10, defaultPrice: 180, category: '資材・経費' },
      { name: '選果・箱詰め作業手数料', unit: '式', taxRate: 10, defaultPrice: 2000, category: '資材・経費' }
    ];

    // よくある出荷先・納品先候補
    const CLIENT_PRESETS = [
      'JA集出荷場（農業協同組合）',
      '道の駅 農産物直売所',
      '地元青果スーパー 青果部',
      '地場産品レストラン 花の木',
      '青果地方卸売市場',
      '個人定期購入者（宅配）'
    ];

    // 今日の日付文字列 (YYYY-MM-DD)
    const getTodayDate = () => {
      const d = new Date();
      const y = d.getFullYear();
      const m = String(d.getMonth() + 1).padStart(2, '0');
      const day = String(d.getDate()).padStart(2, '0');
      return `${y}-${m}-${day}`;
    };

    // 請求書番号ジェネレータ (年月日 + 4桁ランダム)
    const generateInvoiceNumber = () => {
      const d = new Date();
      const ymd = `${d.getFullYear()}${String(d.getMonth() + 1).padStart(2, '0')}${String(d.getDate()).padStart(2, '0')}`;
      const rand = Math.floor(1000 + Math.random() * 9000);
      return `INV-${ymd}-${rand}`;
    };

    // カンマ区切りフォーマット
    const formatYen = (val) => {
      return (Number(val) || 0).toLocaleString('ja-JP');
    };

    function App() {
      // タブ: 'create' | 'history' | 'settings'
      const [currentTab, setCurrentTab] = useState('create');
      // 3ステップウィザード: 1(取引先・日付) -> 2(出荷品目) -> 3(プレビュー・印刷)
      const [wizardStep, setWizardStep] = useState(1);
      const [toastMsg, setToastMsg] = useState(null);
      const [confirmDialog, setConfirmDialog] = useState(null);

      // 自農園プロフィールのローカル保存
      const [farmProfile, setFarmProfile] = useState(() => {
        try {
          const saved = localStorage.getItem('farm_profile_v2');
          if (saved) return JSON.parse(saved);
        } catch (e) {}
        return {
          farmName: 'あずみ野 みのり農園',
          ownerName: '田中 耕作',
          invoiceNumber: 'T1234567890123',
          postalCode: '399-8205',
          address: '長野県安曇野市豊科 1234-5',
          phone: '090-1234-5678',
          bankInfo: '八十二銀行 安曇野支店 普通 1234567 タナカ コウサク',
          sealText: 'みのり\n農園印',
          notesTemplate: '新鮮な採れたて農産物をお届けいたしました。お振込手数料は貴社ご負担にてお願い申し上げます。'
        };
      });

      // 現在編集中の請求書データ
      const [invoice, setInvoice] = useState(() => {
        return {
          id: generateInvoiceNumber(),
          issueDate: getTodayDate(),
          dueDate: '',
          clientName: '道の駅 農産物直売所',
          clientHonorific: '御中',
          subject: '2026年9月度 採れたて野菜納品代金として',
          items: [
            { id: '1', name: '完熟トマト', quantity: 20, unit: '袋', price: 200, taxRate: 8 },
            { id: '2', name: 'きゅうり', quantity: 15, unit: '袋', price: 150, taxRate: 8 },
            { id: '3', name: '出荷用段ボール・資材代', quantity: 3, unit: '枚', price: 180, taxRate: 10 }
          ],
          notes: '新鮮な農産物をお届けいたしました。ご確認の程よろしくお願い申し上げます。'
        };
      });

      // 請求書作成履歴
      const [history, setHistory] = useState(() => {
        try {
          const saved = localStorage.getItem('farm_history_v2');
          if (saved) return JSON.parse(saved);
        } catch (e) {}
        return [];
      });

      // ストレージ同期
      useEffect(() => {
        try {
          localStorage.setItem('farm_profile_v2', JSON.stringify(farmProfile));
        } catch (e) {}
      }, [farmProfile]);

      useEffect(() => {
        try {
          localStorage.setItem('farm_history_v2', JSON.stringify(history));
        } catch (e) {}
      }, [history]);

      // トースト通知ヘルパー
      const showToast = (msg) => {
        setToastMsg(msg);
        setTimeout(() => setToastMsg(null), 3000);
      };

      // 国税庁インボイス要件に準拠した税率別一括計算（端数切り捨て）
      const totals = useMemo(() => {
        let subtotal8 = 0;
        let subtotal10 = 0;

        invoice.items.forEach(item => {
          const lineVal = (Number(item.quantity) || 0) * (Number(item.price) || 0);
          if (Number(item.taxRate) === 8) {
            subtotal8 += lineVal;
          } else {
            subtotal10 += lineVal;
          }
        });

        // 税率ごとに区分した合計金額に税率を乗じ、1回だけ端数処理
        const tax8 = Math.floor(subtotal8 * 0.08);
        const tax10 = Math.floor(subtotal10 * 0.10);

        const totalExclTax = subtotal8 + subtotal10;
        const totalTax = tax8 + tax10;
        const grandTotal = totalExclTax + totalTax;

        return {
          subtotal8,
          tax8,
          total8WithTax: subtotal8 + tax8,
          subtotal10,
          tax10,
          total10WithTax: subtotal10 + tax10,
          totalExclTax,
          totalTax,
          grandTotal
        };
      }, [invoice.items]);

      // 品目の追加
      const handleAddItem = (preset = null) => {
        const newItem = {
          id: Date.now().toString(),
          name: preset ? preset.name : '',
          quantity: 1,
          unit: preset ? preset.unit : '袋',
          price: preset ? preset.defaultPrice : 0,
          taxRate: preset ? preset.taxRate : 8
        };
        setInvoice(prev => ({
          ...prev,
          items: [...prev.items, newItem]
        }));
      };

      // 品目フィールドの更新
      const handleUpdateItem = (id, field, value) => {
        setInvoice(prev => ({
          ...prev,
          items: prev.items.map(item => item.id === id ? { ...item, [field]: value } : item)
        }));
      };

      // 数量のクイック加減 (+1, +5, -1)
      const handleAdjustQty = (id, delta) => {
        setInvoice(prev => ({
          ...prev,
          items: prev.items.map(item => {
            if (item.id === id) {
              const current = Number(item.quantity) || 0;
              const next = Math.max(1, current + delta);
              return { ...item, quantity: next };
            }
            return item;
          })
        }));
      };

      // 品目の削除
      const handleDeleteItem = (id) => {
        if (invoice.items.length <= 1) {
          showToast('明細は1行以上必要です');
          return;
        }
        setInvoice(prev => ({
          ...prev,
          items: prev.items.filter(item => item.id !== id)
        }));
      };

      // 保存処理
      const handleSaveInvoice = () => {
        if (!invoice.clientName.trim()) {
          showToast('⚠️ 請求先名を入力してください');
          setWizardStep(1);
          return;
        }

        const savedRecord = {
          ...invoice,
          calculations: totals,
          savedAt: new Date().toLocaleString('ja-JP')
        };

        setHistory(prev => {
          const idx = prev.findIndex(item => item.id === invoice.id);
          if (idx >= 0) {
            const updated = [...prev];
            updated[idx] = savedRecord;
            return updated;
          }
          return [savedRecord, ...prev];
        });

        showToast('✅ 請求書を履歴に保存しました！');
      };

      // 白紙から新しく作る
      const handleResetNew = () => {
        setConfirmDialog({
          title: '新しい請求書を作りますか？',
          message: '現在編集中の内容は破棄されます。保存しておきたい場合は先に「履歴に保存」を行ってください。',
          onConfirm: () => {
            setInvoice({
              id: generateInvoiceNumber(),
              issueDate: getTodayDate(),
              dueDate: '',
              clientName: '',
              clientHonorific: '御中',
              subject: `${new Date().getMonth() + 1}月度 農産物納品代金として`,
              items: [
                { id: Date.now().toString(), name: '完熟トマト', quantity: 10, unit: '袋', price: 200, taxRate: 8 }
              ],
              notes: farmProfile.notesTemplate || ''
            });
            setWizardStep(1);
            setConfirmDialog(null);
            showToast('新しい請求書を用意しました');
          }
        });
      };

      // 過去データの読み込み
      const handleLoadFromHistory = (item) => {
        setInvoice({ ...item });
        setWizardStep(3);
        setCurrentTab('create');
        showToast(`請求書「${item.clientName}」を読み込みました`);
      };

      // 印刷実行
      const handlePrint = () => {
        if (!invoice.clientName.trim()) {
          showToast('⚠️ 請求先のお名前が未入力です');
          return;
        }
        window.print();
      };

      return (
        <div className="min-h-screen flex flex-col bg-[#F6F8F5]">
          {/* ヘッダーナビゲーション (印刷時は非表示) */}
          <header className="bg-farm-700 text-white shadow-md sticky top-0 z-30 no-print border-b border-farm-800">
            <div className="max-w-5xl mx-auto px-4 py-3 flex items-center justify-between">
              <div className="flex items-center gap-2.5">
                <div className="w-10 h-10 rounded-xl bg-farm-800/80 border border-farm-500/40 flex items-center justify-center text-amber-300 shadow-inner">
                  <IconWheat className="w-6 h-6" />
                </div>
                <div>
                  <h1 className="text-lg sm:text-xl font-bold tracking-tight flex items-center gap-2">
                    農家のかんたんインボイス
                    <span className="hidden sm:inline-block text-[11px] bg-farm-900/60 text-emerald-200 px-2 py-0.5 rounded-full border border-farm-500/40">
                      適格請求書
                    </span>
                  </h1>
                  <p className="text-[11px] text-farm-100 hidden sm:block">
                    畑や直売所でも迷わずサクサク作れる農家専用アプリ
                  </p>
                </div>
              </div>

              {/* タブ切り替えボタン群 */}
              <div className="flex items-center bg-farm-900/50 p-1 rounded-xl border border-farm-600/60">
                <button
                  onClick={() => setCurrentTab('create')}
                  className={`flex items-center gap-1.5 px-3 py-1.5 rounded-lg text-xs sm:text-sm font-bold transition ${
                    currentTab === 'create'
                      ? 'bg-white text-farm-800 shadow'
                      : 'text-farm-100 hover:text-white hover:bg-farm-800/50'
                  }`}
                >
                  <IconFileText className="w-4 h-4" />
                  <span>作成</span>
                </button>
                <button
                  onClick={() => setCurrentTab('history')}
                  className={`flex items-center gap-1.5 px-3 py-1.5 rounded-lg text-xs sm:text-sm font-bold transition ${
                    currentTab === 'history'
                      ? 'bg-white text-farm-800 shadow'
                      : 'text-farm-100 hover:text-white hover:bg-farm-800/50'
                  }`}
                >
                  <IconHistory className="w-4 h-4" />
                  <span>履歴 ({history.length})</span>
                </button>
