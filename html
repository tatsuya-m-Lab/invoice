                          </div>

                          <div className="bg-stone-50 border-2 border-stone-800 p-3.5 rounded-xl">
                            <div className="text-xs font-bold text-stone-600">ご請求金額（税込）</div>
                            <div className="text-3xl font-black text-stone-900 tracking-tight mt-0.5">
                              ¥{formatYen(totals.grandTotal)} -
                            </div>
                          </div>

                          <div className="text-xs text-stone-600 space-y-1">
                            <div><span className="font-bold">件名：</span> {invoice.subject}</div>
                            {invoice.dueDate && <div><span className="font-bold">お支払期日：</span> {invoice.dueDate}</div>}
                          </div>
                        </div>

                        {/* 右：農園発行者情報 ＆ 角印 */}
                        <div className="flex-1 sm:text-right relative">
                          <div className="space-y-1 text-xs sm:text-sm text-stone-700">
                            <div className="font-bold text-stone-900">請求番号：{invoice.id}</div>
                            <div>発行日：{invoice.issueDate}</div>
                            <div className="text-lg font-black text-stone-900 mt-2 font-serif-mincho">
                              {farmProfile.farmName}
                            </div>
                            <div>代表者：{farmProfile.ownerName}</div>
                            <div className="inline-block bg-farm-50 border border-farm-300 text-farm-900 px-2 py-0.5 rounded font-mono text-xs font-bold mt-1">
                              登録番号：{farmProfile.invoiceNumber || '未登録'}
                            </div>
                            <div className="text-xs text-stone-600 mt-1">
                              〒{farmProfile.postalCode} {farmProfile.address}
                            </div>
                            <div className="text-xs text-stone-600">TEL: {farmProfile.phone}</div>
                          </div>

                          {/* 電子角印スタンプ */}
                          <div className="mt-3 sm:absolute sm:right-0 sm:bottom-0 pointer-events-none select-none">
                            <div className="inline-flex items-center justify-center w-20 h-20 border-2 border-rose-600 rounded-lg text-rose-600 font-serif-mincho font-black text-xs p-1 text-center rotate-[-4deg] opacity-85 shadow-sm leading-tight bg-white/70">
                              <pre className="font-serif-mincho font-bold whitespace-pre-line leading-tight">
                                {farmProfile.sealText || '農園\n之印'}
                              </pre>
                            </div>
                          </div>
                        </div>
                      </div>

                      {}
                      {/* 明細テーブル */}
                      <div className="overflow-x-auto mb-6">
                        <table className="w-full border-collapse border border-stone-800 text-xs sm:text-sm">
                          <thead>
                            <tr className="bg-stone-100 border-b border-stone-800 text-stone-900">
                              <th className="border-r border-stone-800 p-2 text-center w-10">No</th>
                              <th className="border-r border-stone-800 p-2 text-left">品名・品目（※は軽減税率8%対象）</th>
                              <th className="border-r border-stone-800 p-2 text-right w-16">数量</th>
                              <th className="border-r border-stone-800 p-2 text-center w-14">単位</th>
                              <th className="border-r border-stone-800 p-2 text-right w-24">単価</th>
                              <th className="border-r border-stone-800 p-2 text-center w-16">税率</th>
                              <th className="p-2 text-right w-28">金額 (税抜)</th>
                            </tr>
                          </thead>
                          <tbody>
                            {invoice.items.map((item, index) => {
                              const lineVal = (Number(item.quantity) || 0) * (Number(item.price) || 0);
                              const isReduced = Number(item.taxRate) === 8;
                              return (
                                <tr key={item.id} className="border-b border-stone-300">
                                  <td className="border-r border-stone-800 p-2 text-center text-stone-500">{index + 1}</td>
                                  <td className="border-r border-stone-800 p-2 font-medium">
                                    {isReduced ? '※ ' : ''}{item.name || '—'}
                                  </td>
                                  <td className="border-r border-stone-800 p-2 text-right">{item.quantity}</td>
                                  <td className="border-r border-stone-800 p-2 text-center text-stone-600">{item.unit}</td>
                                  <td className="border-r border-stone-800 p-2 text-right">¥{formatYen(item.price)}</td>
                                  <td className="border-r border-stone-800 p-2 text-center">{item.taxRate}%</td>
                                  <td className="p-2 text-right font-bold">¥{formatYen(lineVal)}</td>
                                </tr>
                              );
                            })}
                          </tbody>
                        </table>
                      </div>

                      {/* 税率別内訳ブロック & 総合計ブロック */}
                      <div className="grid grid-cols-1 sm:grid-cols-2 gap-4 mb-6 page-break">
                        {/* 税率区分別内訳 */}
                        <div className="border border-stone-800 rounded-lg p-3 text-xs bg-stone-50/70 space-y-1.5">
                          <div className="font-bold border-b border-stone-300 pb-1 text-stone-800">
                            【税率別内訳・消費税額】
                          </div>
                          <div className="flex justify-between py-0.5">
                            <span>※ 8%対象 (税抜計 ¥{formatYen(totals.subtotal8)})</span>
                            <span className="font-bold">消費税: ¥{formatYen(totals.tax8)}</span>
                          </div>
                          <div className="flex justify-between py-0.5">
                            <span>10%対象 (税抜計 ¥{formatYen(totals.subtotal10)})</span>
                            <span className="font-bold">消費税: ¥{formatYen(totals.tax10)}</span>
                          </div>
                          <div className="text-[10px] text-stone-500 pt-1 border-t border-stone-200">
                            ※ 印は軽減税率（農産物・飲食料品）の対象品目であることを示します。
                          </div>
                        </div>

                        {/* 金額総合計 */}
                        <div className="border border-stone-800 rounded-lg p-3 text-xs space-y-1.5 bg-white">
                          <div className="flex justify-between text-stone-700">
                            <span>税抜合計金額：</span>
                            <span className="font-medium">¥{formatYen(totals.totalExclTax)}</span>
                          </div>
                          <div className="flex justify-between text-stone-700">
                            <span>消費税合計額：</span>
                            <span className="font-medium">¥{formatYen(totals.totalTax)}</span>
                          </div>
                          <div className="border-t border-stone-800 pt-1.5 flex justify-between text-sm font-bold text-stone-900">
                            <span>税込合計金額：</span>
                            <span className="text-base font-black">¥{formatYen(totals.grandTotal)}</span>
                          </div>
                        </div>
                      </div>

                      {/* 振込先・備考 */}
                      <div className="border-t-2 border-stone-800 pt-3 text-xs space-y-2 page-break">
                        {farmProfile.bankInfo && (
                          <div>
                            <span className="font-bold">【お振込先】</span>
                            <span className="ml-2 font-mono">{farmProfile.bankInfo}</span>
                          </div>
                        )}
                        {invoice.notes && (
                          <div>
                            <span className="font-bold">【備考】</span>
                            <span className="ml-2 text-stone-700 whitespace-pre-wrap">{invoice.notes}</span>
                          </div>
                        )}
                      </div>
                    </div>
                  </div>
                )}
              </div>
            )}

            {}
            {currentTab === 'history' && (
              <div className="space-y-6">
                <div className="flex flex-col sm:flex-row sm:items-center justify-between gap-3 bg-white p-5 rounded-3xl shadow-sm border border-farm-100">
                  <div>
                    <h2 className="text-xl sm:text-2xl font-bold text-stone-900 flex items-center gap-2">
                      <IconHistory className="w-6 h-6 text-farm-600" />
                      請求書作成履歴
                    </h2>
                    <p className="text-xs sm:text-sm text-stone-500 mt-1">
                      過去に発行した請求書の確認・再印刷や、内容を引き継いで今月分の請求書を作成できます。
                    </p>
                  </div>
                  <button
                    onClick={() => {
                      handleResetNew();
                      setCurrentTab('create');
                    }}
                    className="px-5 py-3 bg-farm-700 hover:bg-farm-800 text-white rounded-2xl font-bold text-sm flex items-center gap-1.5 shadow"
                  >
                    <IconPlus className="w-4 h-4" />
                    あたらしく作成
                  </button>
                </div>

                {history.length === 0 ? (
                  <div className="bg-white rounded-3xl p-12 text-center border border-dashed border-stone-300">
                    <IconFileText className="w-12 h-12 text-stone-300 mx-auto mb-3" />
                    <h3 className="text-lg font-bold text-stone-700 mb-1">保存された請求書はまだありません</h3>
                    <p className="text-sm text-stone-500 max-w-sm mx-auto mb-6">
                      請求書作成画面のステップ3で「履歴に保存」を押すと、ここに一覧として保管されます。
                    </p>
                    <button
                      onClick={() => setCurrentTab('create')}
                      className="px-6 py-3 bg-farm-700 text-white font-bold rounded-2xl shadow hover:bg-farm-800 transition"
                    >
                      請求書を作成する
                    </button>
                  </div>
                ) : (
                  <div className="grid grid-cols-1 gap-4">
                    {history.map((item) => (
                      <div
                        key={item.id}
                        className="bg-white p-5 rounded-2xl border border-stone-200 hover:border-farm-300 transition shadow-sm flex flex-col sm:flex-row items-start sm:items-center justify-between gap-4"
                      >
                        <div className="space-y-1 flex-1">
                          <div className="flex items-center gap-2 flex-wrap">
                            <span className="font-bold text-lg text-stone-900">{item.clientName || '宛先未設定'}</span>
                            <span className="text-xs bg-farm-100 text-farm-800 font-bold px-2 py-0.5 rounded-full">
                              {item.clientHonorific}
                            </span>
                            <span className="text-xs text-stone-400 font-mono">ID: {item.id}</span>
                          </div>
                          <div className="text-xs text-stone-500 flex flex-wrap gap-x-4">
                            <span>発行日: {item.issueDate}</span>
                            <span>品目数: {item.items?.length || 0}点</span>
                            <span>保存日時: {item.savedAt}</span>
                          </div>
                          <div className="text-xs text-stone-600 line-clamp-1">件名: {item.subject}</div>
                        </div>

                        <div className="flex items-center justify-between sm:justify-end w-full sm:w-auto gap-4 border-t sm:border-t-0 pt-3 sm:pt-0">
                          <div className="text-left sm:text-right">
                            <span className="text-xs text-stone-400 block">ご請求額（税込）</span>
                            <span className="text-xl font-black text-farm-900">
                              ¥{formatYen(item.calculations?.grandTotal || 0)}
                            </span>
                          </div>

                          <div className="flex items-center gap-1.5">
                            <button
                              onClick={() => handleLoadFromHistory(item)}
                              className="px-4 py-2 bg-farm-50 hover:bg-farm-100 text-farm-800 font-bold text-xs rounded-xl transition"
                            >
                              開く・印刷
                            </button>
                            <button
                              onClick={() => {
                                setConfirmDialog({
                                  title: 'この請求書履歴を削除しますか？',
                                  message: '削除すると元に戻せません。よろしいですか？',
                                  onConfirm: () => {
                                    setHistory(prev => prev.filter(h => h.id !== item.id));
                                    setConfirmDialog(null);
                                    showToast('履歴を削除しました');
                                  }
                                });
                              }}
                              className="p-2 text-stone-400 hover:text-rose-600 rounded-xl transition"
                            >
                              <IconTrash className="w-4 h-4" />
                            </button>
                          </div>
                        </div>
                      </div>
                    ))}
                  </div>
                )}
              </div>
            )}

            {}
            {currentTab === 'settings' && (
              <div className="bg-white p-5 sm:p-8 rounded-3xl shadow-sm border border-farm-100 space-y-6 max-w-2xl mx-auto">
                <div className="border-b border-stone-100 pb-4">
                  <h2 className="text-xl sm:text-2xl font-bold text-stone-900 flex items-center gap-2">
                    <IconSettings className="w-6 h-6 text-farm-600" />
                    自農園の設定（適格請求書発行者情報）
                  </h2>
                  <p className="text-xs sm:text-sm text-stone-500 mt-1">
                    ここで登録した内容は端末のブラウザに保存され、すべての請求書に自動反映されます。
                  </p>
                </div>

                <div className="space-y-4">
                  <div className="grid grid-cols-1 sm:grid-cols-2 gap-4">
                    <div className="space-y-1.5">
                      <label className="text-sm font-bold text-stone-700">農園名・屋号</label>
                      <input
                        type="text"
                        value={farmProfile.farmName}
                        onChange={(e) => setFarmProfile({ ...farmProfile, farmName: e.target.value })}
                        className="w-full p-3 border border-stone-300 rounded-xl focus:border-farm-600 focus:outline-none"
                      />
                    </div>
                    <div className="space-y-1.5">
                      <label className="text-sm font-bold text-stone-700">代表者氏名</label>
                      <input
                        type="text"
                        value={farmProfile.ownerName}
                        onChange={(e) => setFarmProfile({ ...farmProfile, ownerName: e.target.value })}
                        className="w-full p-3 border border-stone-300 rounded-xl focus:border-farm-600 focus:outline-none"
                      />
                    </div>
                  </div>

                  {/* インボイス番号 */}
                  <div className="space-y-1.5 bg-farm-50/70 p-4 rounded-2xl border border-farm-200">
                    <label className="text-sm font-bold text-farm-900 flex items-center justify-between">
                      <span>適格請求書発行事業者 登録番号</span>
                      <span className="text-xs text-farm-700 font-normal">※ T + 13桁の半角数字</span>
                    </label>
                    <input
                      type="text"
                      value={farmProfile.invoiceNumber}
                      onChange={(e) => {
                        let val = e.target.value.toUpperCase();
                        if (!val.startsWith('T') && val.length > 0) {
                          val = 'T' + val.replace(/[^0-9]/g, '');
                        }
                        setFarmProfile({ ...farmProfile, invoiceNumber: val });
                      }}
                      placeholder="T1234567890123"
                      className="w-full p-3 font-mono font-bold text-base sm:text-lg border-2 border-farm-300 rounded-xl focus:border-farm-600 focus:outline-none bg-white"
                    />
                  </div>

                  <div className="grid grid-cols-1 sm:grid-cols-3 gap-4">
                    <div className="space-y-1.5">
                      <label className="text-sm font-bold text-stone-700">郵便番号</label>
                      <input
                        type="text"
                        value={farmProfile.postalCode}
                        onChange={(e) => setFarmProfile({ ...farmProfile, postalCode: e.target.value })}
                        placeholder="123-4567"
                        className="w-full p-3 border border-stone-300 rounded-xl focus:border-farm-600 focus:outline-none"
                      />
                    </div>
                    <div className="sm:col-span-2 space-y-1.5">
                      <label className="text-sm font-bold text-stone-700">農園の所在地・住所</label>
                      <input
                        type="text"
                        value={farmProfile.address}
                        onChange={(e) => setFarmProfile({ ...farmProfile, address: e.target.value })}
                        className="w-full p-3 border border-stone-300 rounded-xl focus:border-farm-600 focus:outline-none"
                      />
                    </div>
                  </div>

                  <div className="space-y-1.5">
                    <label className="text-sm font-bold text-stone-700">電話番号</label>
                    <input
                      type="text"
                      value={farmProfile.phone}
                      onChange={(e) => setFarmProfile({ ...farmProfile, phone: e.target.value })}
                      className="w-full p-3 border border-stone-300 rounded-xl focus:border-farm-600 focus:outline-none"
                    />
                  </div>

                  <div className="space-y-1.5">
                    <label className="text-sm font-bold text-stone-700">お振込先口座情報</label>
                    <input
                      type="text"
                      value={farmProfile.bankInfo}
                      onChange={(e) => setFarmProfile({ ...farmProfile, bankInfo: e.target.value })}
                      placeholder="例: ○○農業協同組合 本所 普通 1234567 カ）ミノリノウエン"
                      className="w-full p-3 border border-stone-300 rounded-xl focus:border-farm-600 focus:outline-none"
                    />
                  </div>

                  <div className="space-y-1.5">
                    <label className="text-sm font-bold text-stone-700">角印（はんこ）に記載する文字</label>
                    <input
                      type="text"
                      value={farmProfile.sealText}
                      onChange={(e) => setFarmProfile({ ...farmProfile, sealText: e.target.value })}
                      placeholder="例: みのり農園印"
                      className="w-full p-3 border border-stone-300 rounded-xl focus:border-farm-600 focus:outline-none"
                    />
                    <span className="text-[11px] text-stone-500">※ 請求書の右下に朱色の電子スタンプとして印字されます。</span>
                  </div>
                </div>

                <div className="pt-4 border-t border-stone-100 flex justify-end">
                  <button
                    type="button"
                    onClick={() => {
                      showToast('✅ 農園の設定情報を保存しました');
                      setCurrentTab('create');
                    }}
                    className="w-full sm:w-auto px-8 py-3.5 bg-farm-700 hover:bg-farm-800 text-white font-bold rounded-2xl shadow transition"
                  >
                    設定を保存して作成へ戻る
                  </button>
                </div>
              </div>
            )}
          </main>

          {/* フッター */}
          <footer className="mt-auto py-5 text-center text-xs text-stone-400 no-print">
            農家のかんたんインボイス - 日本の農業を応援します。
          </footer>
        </div>
      );
    }

    const root = ReactDOM.createRoot(document.getElementById('root'));
    root.render(<App />);
  </script>
</body>
</html>
